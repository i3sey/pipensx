LZMA_SRCS = 7zAlloc.c 7zArcIn.c 7zBuf.c 7zBuf2.c 7zCrc.c 7zCrcOpt.c 7zDec.c \
	7zFile.c 7zStream.c Bcj2.c Bra.c Bra86.c BraIA64.c CpuArch.c Delta.c \
	LzmaDec.c Lzma2Dec.c Ppmd7.c Ppmd7Dec.c
LZMA_OBJS = $(addprefix $(BUILD_DIR)/vendor/lzma/,$(LZMA_SRCS:.c=.o))

$(BUILD_DIR)/vendor/lzma/%.o: vendor/lzma/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -DZ7_EXTRACT_ONLY -DZ7_PPMD_SUPPORT -Ivendor/lzma -c -o $@ $<


# pipensx PC build (Linux/macOS)
# Public shortcut: make pc (or directly: make -f Makefile.pc)
# Requires: gcc, libcurl (apt: libcurl4-openssl-dev)

# All objects and linked binaries land here — never next to sources.
BUILD_DIR ?= build-pc

CC      = gcc
CXX     = g++
TARGET  = $(BUILD_DIR)/pipensx
CFLAGS  = -O2 -Wall -Wextra -std=c11 \
           -D_GNU_SOURCE -pthread \
           -Ivendor/libutp \
           $(shell pkg-config --cflags libcurl)
# _GLIBCXX_ASSERTIONS turns an out-of-range vector/string index into an abort
# instead of a silent read of whatever is next in the heap. The test suite is
# the only place we get that for free — keep it on here.
CXXFLAGS = -O2 -Wall -Wextra -std=c++17 -D_GLIBCXX_ASSERTIONS \
            -D_GNU_SOURCE -pthread \
            -Ivendor/borealis/library/include \
            -Ivendor/libutp \
            $(shell pkg-config --cflags libcurl)
LDFLAGS = $(shell pkg-config --libs libcurl) -lm -lcrypto
INSTALL_LDFLAGS = -lzstd -lcrypto

# Opt-in: make -f Makefile.pc test SANITIZE=1
ifeq ($(SANITIZE),1)
CFLAGS   += -fsanitize=address,undefined -fno-omit-frame-pointer
CXXFLAGS += -fsanitize=address,undefined -fno-omit-frame-pointer
LDFLAGS  += -fsanitize=address,undefined
endif

# Vendored libutp (μTP/BEP-29): C++ with an extern "C" API. Built with its own
# flags (upstream requires -fpermissive -fno-exceptions -fno-rtti; POSIX picks
# the BSD-sockets paths). Linked into every target that pulls peer.o/torrent.o;
# those link with gcc, so they add -lstdc++ explicitly.
UTP_DIR      = vendor/libutp
UTP_OBJS     = $(addprefix $(BUILD_DIR)/$(UTP_DIR)/, \
               utp_internal.o utp_utils.o utp_hash.o utp_callbacks.o \
               utp_api.o utp_packedsockaddr.o)
UTP_CXXFLAGS = -O2 -std=c++17 -DPOSIX -DNDEBUG -Ivendor/libutp \
               -fpermissive -fno-exceptions -fno-rtti -Wno-sign-compare

# Shared with CMakeLists.txt CORE_SOURCES (minus Switch-only bits).
# scripts/check_source_lists.py cross-checks the two.
CORE_SOURCES = \
    src/core/sha1.c       \
    src/core/sha256.c     \
    src/core/mse.c        \
    src/core/bencode.c    \
    src/core/metainfo.c   \
    src/core/util.c       \
    src/core/net.c        \
    src/core/peer.c       \
    src/core/piece.c      \
    src/core/tracker.c    \
    src/core/dht.c        \
    src/core/torrent.c    \
    src/platform/storage.c \
    vendor/dht/dht.c

SRCS = $(CORE_SOURCES) src/main_pc.c

OBJS = $(addprefix $(BUILD_DIR)/,$(SRCS:.c=.o))
# Native tests discovered by filename. Build rules below still spell out
# link deps; forgetting a run line is impossible — `test` runs every bin.
TEST_SOURCES := $(wildcard tests/test_*.c tests/test_*.cpp)
TEST_BINS := $(sort $(patsubst tests/%,$(BUILD_DIR)/tests/%,$(basename $(TEST_SOURCES))))
# DHT against live routers — always last so a bad network cannot hide others.
TEST_BINS_EARLY := $(filter-out $(BUILD_DIR)/tests/test_manager,$(TEST_BINS))

# Shared by test_manager and test_queue_controls (and anything else that
# links the full DownloadManager graph).
MANAGER_TEST_OBJS = \
		$(BUILD_DIR)/src/app/download_manager.o \
		$(BUILD_DIR)/src/app/task_files.o \
		$(BUILD_DIR)/src/app/web_seed_source.o \
		$(BUILD_DIR)/src/app/stream_ram_budget.o $(BUILD_DIR)/src/app/stream_budget_arbiter.o \
		$(BUILD_DIR)/src/app/request_gate.o \
		$(BUILD_DIR)/src/app/install_pacer.o \
		$(BUILD_DIR)/src/app/debrid_transfer.o $(BUILD_DIR)/src/app/torbox_client.o \
		$(BUILD_DIR)/src/app/torbox_provider.o $(BUILD_DIR)/src/app/torrserver_provider.o \
		$(BUILD_DIR)/src/app/realdebrid_client.o $(BUILD_DIR)/src/app/realdebrid_provider.o \
		$(BUILD_DIR)/src/install/package_stream.o $(BUILD_DIR)/src/install/install_journal.o \
		$(BUILD_DIR)/src/install/install_backend_pc.o \
		$(filter-out $(BUILD_DIR)/src/main_pc.o,$(OBJS)) $(UTP_OBJS)

TEST_SRCS = \
    tests/test_piece.c       \
    src/core/sha1.c          \
    src/core/bencode.c       \
    src/core/metainfo.c      \
    src/core/util.c          \
    src/core/piece.c         \
    src/platform/storage.c

all: $(TARGET)

$(TARGET): $(OBJS) $(UTP_OBJS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS) -lstdc++

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD_DIR)/$(UTP_DIR)/%.o: $(UTP_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(UTP_CXXFLAGS) -c -o $@ $<

$(BUILD_DIR)/tests/test_piece: $(TEST_SRCS)

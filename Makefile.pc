# pipensx PC build (Linux/macOS)
# Public shortcut: make pc (or directly: make -f Makefile.pc)
# Requires: gcc, libcurl (apt: libcurl4-openssl-dev)

CC      = gcc
CXX     = g++
TARGET  = pipensx
CFLAGS  = -O2 -Wall -Wextra -std=c11 \
           -D_GNU_SOURCE -pthread \
           -Ivendor/libutp \
           $(shell pkg-config --cflags libcurl)
# _GLIBCXX_ASSERTIONS turns an out-of-range vector/string index into an abort
# instead of a silent read of whatever is next in the heap. The test suite is
# the only place we get that for free — keep it on here.
CXXFLAGS = -O2 -Wall -Wextra -std=c++17 -D_GLIBCXX_ASSERTIONS \
            -D_GNU_SOURCE -pthread \
            -Ivendor/borealis/library/include \
            -Ivendor/libutp \
            $(shell pkg-config --cflags libcurl)
LDFLAGS = $(shell pkg-config --libs libcurl) -lm -lcrypto
INSTALL_LDFLAGS = -lzstd -lcrypto

# Vendored libutp (μTP/BEP-29): C++ with an extern "C" API. Built with its own
# flags (upstream requires -fpermissive -fno-exceptions -fno-rtti; POSIX picks
# the BSD-sockets paths). Linked into every target that pulls peer.o/torrent.o;
# those link with gcc, so they add -lstdc++ explicitly.
UTP_DIR      = vendor/libutp
UTP_OBJS     = $(UTP_DIR)/utp_internal.o $(UTP_DIR)/utp_utils.o \
               $(UTP_DIR)/utp_hash.o $(UTP_DIR)/utp_callbacks.o \
               $(UTP_DIR)/utp_api.o $(UTP_DIR)/utp_packedsockaddr.o
UTP_CXXFLAGS = -O2 -std=c++17 -DPOSIX -DNDEBUG -Ivendor/libutp \
               -fpermissive -fno-exceptions -fno-rtti -Wno-sign-compare

SRCS = \
    src/core/sha1.c       \
    src/core/sha256.c     \
    src/core/mse.c        \
    src/core/bencode.c    \
    src/core/metainfo.c   \
    src/core/util.c       \
    src/core/net.c        \
    src/core/peer.c       \
    src/core/piece.c      \
    src/core/tracker.c    \
    src/core/dht.c        \
    src/core/torrent.c    \
    src/platform/storage.c \
    vendor/dht/dht.c      \
    src/main_pc.c

OBJS = $(SRCS:.c=.o)
TEST_TARGET = tests/test_piece
MANAGER_TEST_TARGET = tests/test_manager
PACKAGE_TEST_TARGET = tests/test_package_stream
CATALOG_TEST_TARGET = tests/test_catalog
TELEMETRY_TEST_TARGET = tests/test_telemetry
PEER_TEST_TARGET = tests/test_peer
TORRENT_TEST_TARGET = tests/test_torrent
SETTINGS_TEST_TARGET = tests/test_app_settings
FAVORITES_TEST_TARGET = tests/test_favorites
UPDATE_TEST_TARGET = tests/test_update_service
GAME_UPDATE_TEST_TARGET = tests/test_game_update_service
UPDATE_FILE_SELECT_TEST_TARGET = tests/test_update_file_select
UPDATE_TRANSACTION_TEST_TARGET = tests/test_update_transaction
INSTALL_SPACE_TEST_TARGET = tests/test_install_space
BATCH_INSTALL_TEST_TARGET = tests/test_batch_install
RAM_BUDGET_TEST_TARGET = tests/test_stream_ram_budget
BUDGET_ARBITER_TEST_TARGET = tests/test_budget_arbiter
REQUEST_GATE_TEST_TARGET = tests/test_request_gate
INSTALL_PACER_TEST_TARGET = tests/test_install_pacer
JOURNAL_TEST_TARGET = tests/test_install_journal
WEB_SEED_TEST_TARGET = tests/test_web_seed
MSE_TEST_TARGET = tests/test_mse
DHT_CACHE_TEST_TARGET = tests/test_dht_cache
DHT_SHARED_TEST_TARGET = tests/test_dht_shared
BUG_REPORT_TEST_TARGET = tests/test_bug_report
HTTP_TEST_TARGET = tests/test_http_server
WEB_SERVER_TEST_TARGET = tests/test_web_server
PROBE_REPORT_TEST_TARGET = tests/test_probe_report
TORBOX_CLIENT_TEST_TARGET = tests/test_torbox_client
TORBOX_PAIRING_TEST_TARGET = tests/test_torbox_pairing
DEBRID_TRANSFER_TEST_TARGET = tests/test_debrid_transfer
TB_PROVIDER_TEST_TARGET = tests/test_torbox_provider
TS_PROVIDER_TEST_TARGET = tests/test_torrserver_provider
TEST_SRCS = \
    tests/test_piece.c       \
    src/core/sha1.c          \
    src/core/bencode.c       \
    src/core/metainfo.c      \
    src/core/util.c          \
    src/core/piece.c         \
    src/platform/storage.c

all: $(TARGET)

$(TARGET): $(OBJS) $(UTP_OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS) -lstdc++

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

$(UTP_DIR)/%.o: $(UTP_DIR)/%.cpp
	$(CXX) $(UTP_CXXFLAGS) -c -o $@ $<

$(TEST_TARGET): $(TEST_SRCS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

src/app/torbox_client.o: src/app/torbox_client.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/app/torbox_provider.o: src/app/torbox_provider.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/app/torrserver_provider.o: src/app/torrserver_provider.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/app/debrid_transfer.o: src/app/debrid_transfer.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/app/torbox_pairing_server.o: src/app/torbox_pairing_server.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/app/download_manager.o: src/app/download_manager.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/app/web_seed_source.o: src/app/web_seed_source.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/app/stream_ram_budget.o: src/app/stream_ram_budget.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/app/stream_budget_arbiter.o: src/app/stream_budget_arbiter.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/app/request_gate.o: src/app/request_gate.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/app/install_pacer.o: src/app/install_pacer.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/install/%.o: src/install/%.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

tests/test_manager.o: tests/test_manager.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(MANAGER_TEST_TARGET): tests/test_manager.o src/app/download_manager.o \
		src/app/web_seed_source.o \
		src/app/stream_ram_budget.o src/app/stream_budget_arbiter.o \
		src/app/request_gate.o \
		src/app/install_pacer.o \
		src/app/debrid_transfer.o src/app/torbox_client.o \
		src/app/torbox_provider.o src/app/torrserver_provider.o \
		src/install/package_stream.o src/install/install_journal.o \
		src/install/install_backend_pc.o \
		$(filter-out src/main_pc.o,$(OBJS)) $(UTP_OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) $(INSTALL_LDFLAGS) -pthread

$(PACKAGE_TEST_TARGET): tests/test_package_stream.cpp \
		src/install/package_stream.o src/install/install_backend_pc.o \
		src/core/util.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(INSTALL_LDFLAGS) -pthread


src/app/catalog_service.o: src/app/catalog_service.cpp
	$(CXX) $(CXXFLAGS) -Isrc -c -o $@ $<

src/app/snapshot_zstd.o: src/app/snapshot_zstd.cpp src/app/snapshot_zstd.hpp
	$(CXX) $(CXXFLAGS) -Isrc -c -o $@ $<

src/app/catalog_refresh.o: src/app/catalog_refresh.cpp
	$(CXX) $(CXXFLAGS) -Isrc -c -o $@ $<

src/app/magnet_resolver.o: src/app/magnet_resolver.cpp
	$(CXX) $(CXXFLAGS) -Isrc -c -o $@ $<

src/app/game_metadata_service.o: src/app/game_metadata_service.cpp
	$(CXX) $(CXXFLAGS) -Isrc -c -o $@ $<

src/app/catalog_presentation.o: src/app/catalog_presentation.cpp
	$(CXX) $(CXXFLAGS) -Isrc -c -o $@ $<

src/app/mod_index_service.o: src/app/mod_index_service.cpp
	$(CXX) $(CXXFLAGS) -Isrc -c -o $@ $<

src/app/http_server.o: src/app/http_server.cpp
	$(CXX) $(CXXFLAGS) -Isrc -c -o $@ $<

src/app/web_server.o: src/app/web_server.cpp
	$(CXX) $(CXXFLAGS) -Isrc -c -o $@ $<

src/app/web_add_queue.o: src/app/web_add_queue.cpp
	$(CXX) $(CXXFLAGS) -Isrc -c -o $@ $<

$(HTTP_TEST_TARGET): tests/test_http_server.cpp src/app/http_server.o \
		src/core/net.o src/core/util.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ -pthread

$(WEB_SERVER_TEST_TARGET): tests/test_web_server.cpp \
		src/app/web_server.o src/app/web_add_queue.o src/app/http_server.o \
		src/app/magnet_resolver.o src/app/install_space.cpp \
		src/app/download_manager.o src/app/web_seed_source.o \
		src/app/stream_ram_budget.o src/app/stream_budget_arbiter.o \
		src/app/request_gate.o \
		src/app/install_pacer.o \
		src/app/debrid_transfer.o src/app/torbox_client.o \
		src/app/torbox_provider.o src/app/torrserver_provider.o \
		src/install/package_stream.o src/install/install_journal.o \
		src/install/install_backend_pc.o \
		$(filter-out src/main_pc.o,$(OBJS)) $(UTP_OBJS)
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS) \
		$(INSTALL_LDFLAGS) -lz -pthread

$(CATALOG_TEST_TARGET): tests/test_catalog.cpp \
		src/app/catalog_service.o src/app/catalog_refresh.o \
		src/app/catalog_presentation.o \
		src/app/snapshot_zstd.o \
		src/app/mod_index_service.o \
		src/app/game_metadata_service.o \
		src/app/magnet_resolver.o \
		src/core/tracker.o src/core/net.o \
		src/core/dht.o vendor/dht/dht.o \
		src/core/bencode.o src/core/metainfo.o src/core/sha1.o src/core/sha256.o \
		src/core/mse.o \
		src/core/util.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS) -lzstd

# The sysmodule probe's telemetry (sample ring, event log, ini parser) is plain
# C with no libnx, so the PC build covers it. The rest of src/probe is Switch
# services and only builds under CMake.
$(PROBE_REPORT_TEST_TARGET): tests/test_probe_report.c src/probe/probe_report.c
	$(CC) $(CFLAGS) -o $@ $^

test: $(TEST_TARGET) $(MANAGER_TEST_TARGET) $(PACKAGE_TEST_TARGET) \
		$(CATALOG_TEST_TARGET) \
		$(TELEMETRY_TEST_TARGET) $(PEER_TEST_TARGET) \
		$(TORRENT_TEST_TARGET) $(SETTINGS_TEST_TARGET) $(UPDATE_TEST_TARGET) \
		$(GAME_UPDATE_TEST_TARGET) \
		$(UPDATE_FILE_SELECT_TEST_TARGET) \
		$(UPDATE_TRANSACTION_TEST_TARGET) \
		$(INSTALL_SPACE_TEST_TARGET) $(BATCH_INSTALL_TEST_TARGET) \
		$(RAM_BUDGET_TEST_TARGET) $(BUDGET_ARBITER_TEST_TARGET) \
		$(REQUEST_GATE_TEST_TARGET) \
		$(INSTALL_PACER_TEST_TARGET) \
		$(JOURNAL_TEST_TARGET) $(WEB_SEED_TEST_TARGET) \
		$(FAVORITES_TEST_TARGET) \
		$(MSE_TEST_TARGET) $(DHT_CACHE_TEST_TARGET) \
		$(DHT_SHARED_TEST_TARGET) \
		$(BUG_REPORT_TEST_TARGET) \
		$(HTTP_TEST_TARGET) $(WEB_SERVER_TEST_TARGET) \
		$(PROBE_REPORT_TEST_TARGET) \
		$(TORBOX_CLIENT_TEST_TARGET) $(TORBOX_PAIRING_TEST_TARGET) \
		$(DEBRID_TRANSFER_TEST_TARGET) \
		$(TB_PROVIDER_TEST_TARGET) $(TS_PROVIDER_TEST_TARGET)
	./$(TEST_TARGET)
	./$(PACKAGE_TEST_TARGET)
	./$(CATALOG_TEST_TARGET)
	./$(TELEMETRY_TEST_TARGET)
	./$(PEER_TEST_TARGET)
	./$(TORRENT_TEST_TARGET)
	./$(SETTINGS_TEST_TARGET)
	./$(UPDATE_TEST_TARGET)
	./$(GAME_UPDATE_TEST_TARGET)
	./$(UPDATE_FILE_SELECT_TEST_TARGET)
	./$(UPDATE_TRANSACTION_TEST_TARGET)
	./$(INSTALL_SPACE_TEST_TARGET)
	./$(BATCH_INSTALL_TEST_TARGET)
	./$(RAM_BUDGET_TEST_TARGET)
	./$(BUDGET_ARBITER_TEST_TARGET)
	./$(REQUEST_GATE_TEST_TARGET)
	./$(INSTALL_PACER_TEST_TARGET)
	./$(JOURNAL_TEST_TARGET)
	./$(WEB_SEED_TEST_TARGET)
	./$(FAVORITES_TEST_TARGET)
	./$(MSE_TEST_TARGET)
	./$(DHT_CACHE_TEST_TARGET)
	./$(DHT_SHARED_TEST_TARGET)
	./$(BUG_REPORT_TEST_TARGET)
	./$(HTTP_TEST_TARGET)
	./$(WEB_SERVER_TEST_TARGET)
	./$(PROBE_REPORT_TEST_TARGET)
	./$(TORBOX_CLIENT_TEST_TARGET)
	./$(TORBOX_PAIRING_TEST_TARGET)
	./$(DEBRID_TRANSFER_TEST_TARGET)
	./$(TB_PROVIDER_TEST_TARGET)
	./$(TS_PROVIDER_TEST_TARGET)
	python3 tests/test_bug_report_decode.py
	python3 tests/test_telemetry_analyzer.py
	python3 scripts/check_i18n.py
	# last: bootstraps DHT against live routers, so it fails on a bad
	# network. Running it here keeps that from hiding the other 25.
	./$(MANAGER_TEST_TARGET)

$(SETTINGS_TEST_TARGET): tests/test_app_settings.cpp src/app/app_settings.cpp \
		src/core/util.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^

$(UPDATE_TEST_TARGET): tests/test_update_service.cpp src/app/update_service.cpp \
		src/app/update_transaction.o src/core/sha256.c
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS) -Wl,--wrap=rename

$(GAME_UPDATE_TEST_TARGET): tests/test_game_update_service.cpp \
		src/app/game_update_service.cpp src/app/update_service.cpp \
		src/app/update_transaction.o src/core/sha256.c src/core/util.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS)

$(UPDATE_FILE_SELECT_TEST_TARGET): tests/test_update_file_select.cpp \
		src/app/game_update_install.cpp
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^

$(UPDATE_TRANSACTION_TEST_TARGET): tests/test_update_transaction.c \
		src/app/update_transaction.c src/core/sha256.c
	$(CC) $(CFLAGS) -Isrc -o $@ $^ -Wl,--wrap=rename

$(INSTALL_SPACE_TEST_TARGET): tests/test_install_space.cpp \
		src/app/install_space.cpp
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^

$(FAVORITES_TEST_TARGET): tests/test_favorites.cpp \
		src/app/favorites_service.cpp
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^

$(BATCH_INSTALL_TEST_TARGET): tests/test_batch_install.cpp \
		src/app/catalog_batch_installer.cpp src/app/install_space.cpp \
		src/app/download_manager.o src/app/web_seed_source.o \
		src/app/stream_ram_budget.o src/app/stream_budget_arbiter.o \
		src/app/request_gate.o src/app/debrid_transfer.o \
		src/app/install_pacer.o \
		src/app/torbox_client.o src/app/torbox_provider.o \
		src/app/torrserver_provider.o \
		src/install/package_stream.o src/install/install_journal.o \
		src/install/install_backend_pc.o \
		$(filter-out src/main_pc.o,$(OBJS)) $(UTP_OBJS)
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS) \
		$(INSTALL_LDFLAGS) -pthread

$(RAM_BUDGET_TEST_TARGET): tests/test_stream_ram_budget.cpp \
		src/app/stream_ram_budget.cpp
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^

$(BUDGET_ARBITER_TEST_TARGET): tests/test_budget_arbiter.cpp \
		src/app/stream_budget_arbiter.cpp src/app/stream_ram_budget.cpp
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^

$(REQUEST_GATE_TEST_TARGET): tests/test_request_gate.cpp \
		src/app/request_gate.cpp
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^

$(INSTALL_PACER_TEST_TARGET): tests/test_install_pacer.cpp \
		src/app/install_pacer.cpp
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ -pthread

$(JOURNAL_TEST_TARGET): tests/test_install_journal.cpp \
		src/install/install_journal.o src/core/bencode.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^

$(WEB_SEED_TEST_TARGET): tests/test_web_seed.cpp src/app/web_seed_source.o \
		src/core/util.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS) -pthread

$(MSE_TEST_TARGET): tests/test_mse.c src/core/mse.c src/core/sha1.c \
	src/core/util.c
	$(CC) $(CFLAGS) -Isrc -o $@ $^ $(LDFLAGS) -lcrypto

$(DHT_CACHE_TEST_TARGET): tests/test_dht_cache.c src/core/dht.c \
		vendor/dht/dht.c src/core/net.c src/core/sha1.c src/core/util.c
	$(CC) $(CFLAGS) -Isrc -o $@ $^ $(LDFLAGS)

# dht.c is a real prerequisite (the test #includes it as source) but must
# not be passed to the compiler a second time — hence the filter-out in $^.
$(DHT_SHARED_TEST_TARGET): tests/test_dht_shared.c src/core/dht.c \
		vendor/dht/dht.c src/core/net.c src/core/sha1.c src/core/util.c
	$(CC) $(CFLAGS) -Isrc -o $@ $(filter-out src/core/dht.c,$^) $(LDFLAGS)

$(BUG_REPORT_TEST_TARGET): tests/test_bug_report.cpp src/app/bug_report.cpp
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ -lz

$(TORBOX_CLIENT_TEST_TARGET): tests/test_torbox_client.cpp \
		src/app/torbox_client.o src/core/util.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS)

$(TB_PROVIDER_TEST_TARGET): tests/test_torbox_provider.cpp \
		src/app/torbox_provider.o src/app/torbox_client.o src/core/util.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS)

$(TS_PROVIDER_TEST_TARGET): tests/test_torrserver_provider.cpp \
		src/app/torrserver_provider.o src/core/util.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS)

$(TORBOX_PAIRING_TEST_TARGET): tests/test_torbox_pairing.cpp \
		src/app/torbox_pairing_server.o src/app/http_server.o \
		src/core/net.o src/core/util.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS) -pthread

$(DEBRID_TRANSFER_TEST_TARGET): tests/test_debrid_transfer.cpp \
		src/app/debrid_transfer.o src/app/torbox_client.o \
		src/app/install_pacer.o \
		src/app/stream_ram_budget.o \
		src/app/torbox_provider.o \
		src/install/package_stream.o src/install/install_backend_pc.o \
		src/core/util.o
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS) $(INSTALL_LDFLAGS) -pthread

$(TELEMETRY_TEST_TARGET): tests/test_telemetry.c src/core/util.c
	$(CC) $(CFLAGS) -Isrc -o $@ $^ $(LDFLAGS)

$(PEER_TEST_TARGET): tests/test_peer.c src/core/peer.c src/core/net.c \
		src/core/bencode.c src/core/util.c src/core/mse.c src/core/sha1.c \
		$(UTP_OBJS)
	$(CC) $(CFLAGS) -Isrc -o $@ $^ $(LDFLAGS) -lstdc++ -Wl,--wrap=setsockopt

# torrent.c is a real prerequisite (the test #includes it as source) but must
# not be passed to the compiler a second time — hence the filter-out in $^.
$(TORRENT_TEST_TARGET): tests/test_torrent.c src/core/torrent.c \
		$(filter-out src/core/torrent.o src/main_pc.o,$(OBJS)) $(UTP_OBJS)
	$(CC) $(CFLAGS) -Isrc -o $@ $(filter-out src/core/torrent.c,$^) \
		$(LDFLAGS) -lstdc++

# Manual browser testing for the web companion (not part of all/test):
#   make -f Makefile.pc webserver && ./tools/webserver
webserver: tools/webserver

tools/webserver: tools/web_server_main.cpp \
		src/app/web_server.o src/app/web_add_queue.o src/app/http_server.o \
		src/app/catalog_service.o src/app/catalog_refresh.o \
		src/app/snapshot_zstd.o \
		src/app/mod_index_service.o src/app/game_metadata_service.o \
		src/app/magnet_resolver.o src/app/install_space.cpp \
		src/app/download_manager.o src/app/web_seed_source.o \
		src/app/stream_ram_budget.o src/app/stream_budget_arbiter.o \
		src/app/request_gate.o \
		src/app/install_pacer.o \
		src/app/debrid_transfer.o src/app/torbox_client.o \
		src/app/torbox_provider.o src/app/torrserver_provider.o \
		src/install/package_stream.o src/install/install_journal.o \
		src/install/install_backend_pc.o \
		$(filter-out src/main_pc.o,$(OBJS)) $(UTP_OBJS)
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS) \
		$(INSTALL_LDFLAGS) -lz -pthread

clean:
	rm -f $(OBJS) $(UTP_OBJS) src/app/download_manager.o \
		src/app/web_seed_source.o src/app/stream_ram_budget.o \
		src/app/stream_budget_arbiter.o src/app/request_gate.o \
		src/app/install_pacer.o \
		src/app/torbox_client.o src/app/torbox_pairing_server.o \
		src/app/debrid_transfer.o src/app/torrserver_provider.o \
		src/app/torbox_provider.o \
		src/app/catalog_service.o src/app/snapshot_zstd.o \
		src/app/catalog_presentation.o src/app/game_metadata_service.o \
		src/app/magnet_resolver.o \
		src/install/*.o \
		tests/test_manager.o $(TARGET) $(TEST_TARGET) \
		$(MANAGER_TEST_TARGET) $(PACKAGE_TEST_TARGET) \
		$(CATALOG_TEST_TARGET) \
		$(TELEMETRY_TEST_TARGET) $(PEER_TEST_TARGET) \
		$(TORRENT_TEST_TARGET) $(SETTINGS_TEST_TARGET) $(UPDATE_TEST_TARGET) \
		$(GAME_UPDATE_TEST_TARGET) $(UPDATE_FILE_SELECT_TEST_TARGET) \
		$(UPDATE_TRANSACTION_TEST_TARGET) \
		$(INSTALL_SPACE_TEST_TARGET) $(BATCH_INSTALL_TEST_TARGET) \
		$(RAM_BUDGET_TEST_TARGET) $(BUDGET_ARBITER_TEST_TARGET) \
		$(REQUEST_GATE_TEST_TARGET) \
		$(INSTALL_PACER_TEST_TARGET) \
		$(JOURNAL_TEST_TARGET) $(FAVORITES_TEST_TARGET) \
		$(MSE_TEST_TARGET) $(DHT_SHARED_TEST_TARGET) \
		$(BUG_REPORT_TEST_TARGET) \
		src/app/http_server.o src/app/web_server.o src/app/web_add_queue.o \
		$(HTTP_TEST_TARGET) $(WEB_SERVER_TEST_TARGET) \
		$(PROBE_REPORT_TEST_TARGET) \
		$(TORBOX_CLIENT_TEST_TARGET) $(TORBOX_PAIRING_TEST_TARGET) \
		$(DEBRID_TRANSFER_TEST_TARGET) \
		$(TB_PROVIDER_TEST_TARGET) $(TS_PROVIDER_TEST_TARGET)

.PHONY: all test clean

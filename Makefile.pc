# Manual browser testing for the web companion (not part of all/test):
#   make -f Makefile.pc webserver && ./build-pc/tools/webserver
webserver: $(BUILD_DIR)/tools/webserver

$(BUILD_DIR)/tools/webserver: tools/web_server_main.cpp \
		$(BUILD_DIR)/src/app/web_server.o $(BUILD_DIR)/src/app/web_add_queue.o $(BUILD_DIR)/src/app/http_server.o \
		$(BUILD_DIR)/src/app/catalog_service.o $(BUILD_DIR)/src/app/catalog_refresh.o \
		$(BUILD_DIR)/src/app/snapshot_zstd.o \
		$(BUILD_DIR)/src/app/mod_index_service.o $(BUILD_DIR)/src/app/game_metadata_service.o \
		$(BUILD_DIR)/src/app/magnet_resolver.o src/app/install_space.cpp \
		$(BUILD_DIR)/src/app/download_manager.o $(BUILD_DIR)/src/app/task_files.o \
		$(BUILD_DIR)/src/app/web_seed_source.o \
		$(BUILD_DIR)/src/app/stream_ram_budget.o $(BUILD_DIR)/src/app/stream_budget_arbiter.o \
		$(BUILD_DIR)/src/app/request_gate.o \
		$(BUILD_DIR)/src/app/install_pacer.o \
		$(BUILD_DIR)/src/app/debrid_transfer.o $(BUILD_DIR)/src/app/torbox_client.o \
		$(BUILD_DIR)/src/app/torbox_provider.o $(BUILD_DIR)/src/app/torrserver_provider.o \
		$(BUILD_DIR)/src/app/realdebrid_client.o $(BUILD_DIR)/src/app/realdebrid_provider.o \
		$(BUILD_DIR)/src/install/package_stream.o $(BUILD_DIR)/src/install/install_journal.o \
		$(BUILD_DIR)/src/install/install_backend_pc.o \
		$(filter-out $(BUILD_DIR)/src/main_pc.o,$(OBJS)) $(UTP_OBJS)
	$(CXX) $(CXXFLAGS) -Isrc -o $@ $^ $(LDFLAGS) \
		$(INSTALL_LDFLAGS) -lz -pthread

# Optional libFuzzer targets (clang required):
#   make -f Makefile.pc fuzz-bencode fuzz-metainfo
#   ./build-pc/fuzz/fuzz_bencode -runs=10000
FUZZ_CC ?= clang
FUZZ_CFLAGS = -O1 -g -fsanitize=fuzzer,address,undefined -fno-omit-frame-pointer \
	-D_GNU_SOURCE -Ivendor/libutp

$(BUILD_DIR)/fuzz/fuzz_bencode: fuzz/fuzz_bencode.c src/core/bencode.c
	@mkdir -p $(dir $@)
	$(FUZZ_CC) $(FUZZ_CFLAGS) -o $@ $^

$(BUILD_DIR)/fuzz/fuzz_metainfo: fuzz/fuzz_metainfo.c \
		src/core/metainfo.c src/core/bencode.c src/core/sha1.c src/core/util.c
	@mkdir -p $(dir $@)
	$(FUZZ_CC) $(FUZZ_CFLAGS) -o $@ $^

fuzz-bencode: $(BUILD_DIR)/fuzz/fuzz_bencode
fuzz-metainfo: $(BUILD_DIR)/fuzz/fuzz_metainfo

# Short smoke: enough to prove the harness links and rejects junk.
fuzz-smoke: fuzz-bencode fuzz-metainfo
	./$(BUILD_DIR)/fuzz/fuzz_bencode -runs=1000 -max_len=4096
	./$(BUILD_DIR)/fuzz/fuzz_metainfo -runs=1000 -max_len=65536

clean:
	rm -rf $(BUILD_DIR)
	# Leftover in-tree objects from older Makefile.pc revisions.
	find src tests vendor/libutp vendor/dht -name '*.o' -delete 2>/dev/null || true

.PHONY: all test clean fuzz-bencode fuzz-metainfo fuzz-smoke
